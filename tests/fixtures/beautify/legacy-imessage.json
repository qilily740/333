"/* 仿 iMessage */\n.phone{--surface:#ffffff;background:#ffffff;--chat-surface:#ffffff;--chat-role:#ffffff;--chat-mine:#007aff;--chat-mine-ink:#ffffff}\n.conversation{background:transparent}\n.topbar{background:var(--chat-surface);border-color:#e6e6eb}\n.message{--chat-fill:var(--chat-role);--chat-ink:#111111;align-items:flex-start;gap:8px;margin:16px 0}\n.message.mine{--chat-fill:var(--chat-mine);--chat-ink:var(--chat-mine-ink)}\n.message.is-grouped{margin-top:6px}\n.message-content{min-width:0}\n.message-type-text .message-content{max-width:calc(100% - 92px)}\n.message-type-text .bubble{flex-shrink:0;min-width:0;max-width:100%}\n.message-bubble-line{gap:9px;align-items:flex-end}\n.bubble{position:relative;isolation:isolate;background:var(--chat-fill);color:var(--chat-ink);border:0;border-radius:20px;box-shadow:none;padding:10px 13px;line-height:1.65}\n.mine .bubble{background:var(--chat-fill);color:var(--chat-ink);border:0;border-radius:20px}\n.bubble-text{color:inherit}\n.mine .bubble::after,.voice-message-card::after,.transfer-message-card::after,.location-message-card::after{content:\"\";position:absolute;z-index:-1;pointer-events:none;background:var(--chat-fill);bottom:0;left:-7px;width:15px;height:20px;transform:scaleX(-1);clip-path:path(\"M0 0 H8 V9 C8 14 10 17 15 20 C5 21 0 16 0 8 Z\")}\n.mine .bubble::after,.mine .voice-message-card::after,.mine .transfer-message-card::after,.mine .location-message-card::after{left:auto;right:-7px;transform:none}\n.message-time{font-size:9px;color:#9a9a9f;margin-bottom:3px}\n.message .bubble-translation{color:#888;font-size:10px}\n.bubble-quote{border-left-color:currentColor;background:#ffffff24;color:inherit;padding:6px 9px;border-radius:4px}\n.bubble-quote-speaker,.bubble-quote p{color:inherit}\n\n.voice-message-wrap{overflow:visible}\n.voice-message-card{position:relative;isolation:isolate;background:var(--chat-fill);color:var(--chat-ink);border:0;border-radius:20px;overflow:visible}\n.mine .voice-message-card,.voice-message-card:hover,.mine .voice-message-card:hover{background:var(--chat-fill);color:var(--chat-ink);border-radius:20px}\n.voice-wave i{background:currentColor}.voice-duration,.voice-mark{color:inherit}\n.transfer-message-card{position:relative;isolation:isolate;overflow:visible;width:min(63vw,250px);border:0;border-radius:17px;background:var(--chat-fill);color:var(--chat-ink);box-shadow:none}\n.mine .transfer-message-card{background:var(--chat-fill)}\n.transfer-message-card::after{background:var(--chat-fill)}\n.transfer-card-head{padding:13px 14px 4px;border:0;color:inherit;gap:8px}\n.transfer-card-head small{color:inherit;opacity:.8;font-size:9px}\n.transfer-symbol{border:1px solid currentColor;border-radius:50%;color:inherit;width:25px;height:25px}\n.transfer-amount{padding:3px 0 9px;margin:0 14px;border:0;background:none;color:inherit;gap:6px}\n.transfer-amount span,.transfer-amount strong{color:inherit}.transfer-amount strong{font:500 26px -apple-system,BlinkMacSystemFont,sans-serif}\n.transfer-exchange{margin:0 14px 9px;color:inherit;opacity:.8}\n.transfer-parties{color:inherit;border-color:currentColor;opacity:.7;padding:0 0 8px}.transfer-parties strong,.transfer-parties i{color:inherit}\n.transfer-note{padding:9px 14px;background:#00000006;color:inherit;border-radius:0 0 17px 17px;grid-template-columns:30px minmax(0,1fr);gap:6px}\n.transfer-note small,.transfer-note p{color:inherit;font-size:10px}\n.transfer-actions{margin:0;padding:9px 14px;background:transparent;border-top:1px solid #ffffff40;border-radius:0 0 17px 17px}\n.transfer-actions button,.transfer-actions button+button{color:inherit}\n.location-message-card{--chat-fill:#ffffff;position:relative;isolation:isolate;display:flex;flex-direction:column;overflow:visible;width:min(63vw,250px);border:1px solid #e3e3e3;border-radius:17px;background:#ffffff;color:#222222;box-shadow:none}\n.mine .location-message-card{--chat-fill:#ffffff;background:#ffffff;color:#222222}\n.location-info{order:-1;padding:12px 13px;gap:6px 10px}.location-name strong{font-size:13px;color:#222222}\n.location-name small{color:#999999}.location-distance{border:0;min-width:0;padding-left:0}.location-distance strong{font-size:10px;color:#888888}\n.location-map{height:112px;border-radius:0 0 17px 17px}\n.location-tiles img{filter:none}.location-pin{background:#007aff;color:#ffffff}\n.location-detail{color:#888888;border-color:#eeeeee}.location-card-foot{color:#999999;border-color:#eeeeee;order:2}\n.music-chat-invite,.image-description-card{background:#ffffff;border-color:#e3e3e3;border-radius:17px;color:#333333}\n.chat-pat-card{background:transparent;color:#999999}\n\n.message>.avatar{align-self:flex-end;margin-top:0;transform:translateY(13px)}\n.message:not(.mine){--chat-role:rgba(242,243,247,.72)}\n.message:not(.mine) .bubble{background:transparent;border:0;box-shadow:none;min-width:48px;min-height:41px;-webkit-backdrop-filter:none;backdrop-filter:none}\n.message:not(.mine) .bubble::after{content:none;display:none}\n.message:not(.mine) .bubble::before{content:\"\";position:absolute;inset:0 0 0 -7px;z-index:-1;pointer-events:none;background:var(--chat-role);-webkit-backdrop-filter:blur(16px) saturate(135%);backdrop-filter:blur(16px) saturate(135%);clip-path:polygon(27px 0,calc(100% - 20px) 0,calc(100% - 12.35px) 1.52px,calc(100% - 5.86px) 5.86px,calc(100% - 1.52px) 12.35px,100% 20px,100% calc(100% - 20px),calc(100% - 1.52px) calc(100% - 12.35px),calc(100% - 5.86px) calc(100% - 5.86px),calc(100% - 12.35px) calc(100% - 1.52px),calc(100% - 20px) 100%,27px 100%,20px calc(100% - 1px),15px calc(100% - 4px),10px calc(100% - 1px),5px 100%,0 calc(100% - 1px),5px calc(100% - 5px),7px calc(100% - 10px),7px calc(100% - 20px),7px 20px,8.52px 12.35px,12.86px 5.86px,19.35px 1.52px)}\n\n\n.phone{--iris-current-role-header:1}\n.bottom{background:transparent;border-color:transparent;box-shadow:none}\n.topbar{display:grid;grid-template-columns:34px minmax(0,1fr) 34px;grid-template-rows:58px auto;align-items:center;justify-items:center;gap:6px 12px;min-height:calc(var(--app-safe-top,0px) + 104px);padding-top:calc(var(--app-safe-top,0px) + 12px);padding-bottom:12px;background:transparent;-webkit-backdrop-filter:none;backdrop-filter:none;border-bottom:1px solid #ffffff30}\n.topbar .top-actions{display:contents}.topbar #characters{grid-column:2;grid-row:1;display:flex;align-items:center;justify-content:center;position:relative;z-index:2;width:58px;height:58px;margin:0;padding:0;background:transparent;filter:none;opacity:1;-webkit-backdrop-filter:none;backdrop-filter:none}.topbar #characters .avatar:not(:first-child){display:none}.topbar #characters .avatar:first-child{position:relative;width:56px;height:56px;margin:0;transform:none;border:0;box-shadow:none;filter:none;opacity:1;-webkit-backdrop-filter:none;backdrop-filter:none;font-size:22px}.topbar #characters .avatar img{filter:none;opacity:1;-webkit-backdrop-filter:none;backdrop-filter:none}\n.topbar #chatTitle{grid-column:2;grid-row:2;position:relative;z-index:1;display:inline-flex;align-items:center;justify-content:center;gap:8px;max-width:100%;min-width:0;margin:-12px 0 0;min-width:96px;min-height:36px;padding:8px 28px;font-size:0;line-height:1.3;letter-spacing:0;text-align:center;cursor:pointer;border:1px solid #ffffffa6;border-radius:999px;background:linear-gradient(135deg,rgba(255,255,255,.72),rgba(236,239,245,.56));-webkit-backdrop-filter:blur(40px) saturate(170%) contrast(85%);backdrop-filter:blur(40px) saturate(170%) contrast(85%);box-shadow:inset 0 1px 0 #ffffffe6,inset 0 -1px 0 #ffffff66,0 3px 12px #20253514}.topbar #chatTitle::after{content:\"\";position:absolute;right:13px;top:50%;width:5px;height:5px;border-right:1.5px solid #555;border-bottom:1.5px solid #555;transform:translateY(-50%) rotate(-45deg)}.topbar #chatTitle .chat-character-name{display:block;min-width:0;margin:0;font:500 13px/1.4 -apple-system,BlinkMacSystemFont,sans-serif;color:#17171b;letter-spacing:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}\n.topbar #settings{grid-column:3;grid-row:1 / 3;width:30px;height:34px;color:#007aff;align-self:center}.topbar #settings svg{width:21px;height:21px}\n\n"
