"/* 仿微信 */\n.phone{--surface:#ffffff;background:#ffffff;--chat-surface:#ffffff;--chat-role:#ffffff;--chat-mine:#95ec69;--chat-mine-ink:#161616}\n.conversation{background:transparent}\n.topbar{background:var(--chat-surface);border-color:#dfdfdf}\n.message{--chat-fill:var(--chat-role);--chat-ink:#111111;align-items:flex-start;gap:8px;margin:16px 0}\n.message.mine{--chat-fill:var(--chat-mine);--chat-ink:var(--chat-mine-ink)}\n.message.is-grouped{margin-top:6px}\n.message-content{min-width:0}\n.message-type-text .message-content{max-width:calc(100% - 92px)}\n.message-type-text .bubble{flex-shrink:0;min-width:0;max-width:100%}\n.message-bubble-line{gap:9px;align-items:flex-end}\n.bubble{position:relative;isolation:isolate;background:var(--chat-fill);color:var(--chat-ink);border:0;border-radius:5px;box-shadow:none;padding:10px 13px;line-height:1.65}\n.mine .bubble{background:var(--chat-fill);color:var(--chat-ink);border:0;border-radius:5px}\n.bubble-text{color:inherit}\n.bubble::after,.voice-message-card::after,.transfer-message-card::after,.location-message-card::after{content:\"\";position:absolute;z-index:-1;pointer-events:none;background:var(--chat-fill);top:14px;left:-7px;width:9px;height:13px;clip-path:polygon(0 50%,100% 0,100% 100%)}\n.mine .bubble::after,.mine .voice-message-card::after,.mine .transfer-message-card::after,.mine .location-message-card::after{left:auto;right:-7px;transform:scaleX(-1)}\n.message-time{font-size:9px;color:#9a9a9f;margin-bottom:3px}\n.message .bubble-translation{color:#888;font-size:10px}\n.bubble-quote{border-left-color:currentColor;background:#00000009;color:inherit;padding:6px 9px;border-radius:4px}\n.bubble-quote-speaker,.bubble-quote p{color:inherit}\n.input-wrap,.dock-capsule{background:#ffffff;border-color:#dddddf;box-shadow:none}\n.voice-message-wrap{overflow:visible}\n.voice-message-card{position:relative;isolation:isolate;background:var(--chat-fill);color:var(--chat-ink);border:0;border-radius:5px;overflow:visible}\n.mine .voice-message-card,.voice-message-card:hover,.mine .voice-message-card:hover{background:var(--chat-fill);color:var(--chat-ink);border-radius:5px}\n.voice-wave i{background:currentColor}.voice-duration,.voice-mark{color:inherit}\n.transfer-message-card{position:relative;isolation:isolate;overflow:visible;width:min(63vw,250px);border:0;border-radius:5px;background:#f79d36;color:#ffffff;box-shadow:none}\n.mine .transfer-message-card{background:#f79d36}\n.transfer-message-card::after{background:#f79d36}\n.transfer-card-head{padding:13px 14px 4px;border:0;color:inherit;gap:8px}\n.transfer-card-head small{color:inherit;opacity:.8;font-size:9px}\n.transfer-symbol{border:1px solid currentColor;border-radius:50%;color:inherit;width:25px;height:25px}\n.transfer-amount{padding:3px 0 9px;margin:0 14px;border:0;background:none;color:inherit;gap:6px}\n.transfer-amount span,.transfer-amount strong{color:inherit}.transfer-amount strong{font:500 26px -apple-system,BlinkMacSystemFont,sans-serif}\n.transfer-exchange{margin:0 14px 9px;color:inherit;opacity:.8}\n.transfer-parties{color:inherit;border-color:currentColor;opacity:.7;padding:0 0 8px}.transfer-parties strong,.transfer-parties i{color:inherit}\n.transfer-note{padding:9px 14px;background:#ffffff;color:#777777;border-radius:0 0 5px 5px;grid-template-columns:30px minmax(0,1fr);gap:6px}\n.transfer-note small,.transfer-note p{color:inherit;font-size:10px}\n.transfer-actions{margin:0;padding:9px 14px;background:#ffffff;border-top:1px solid #eeeeee;border-radius:0 0 5px 5px}\n.transfer-actions button,.transfer-actions button+button{color:#576b95}\n.location-message-card{--chat-fill:#ffffff;position:relative;isolation:isolate;display:flex;flex-direction:column;overflow:visible;width:min(63vw,250px);border:1px solid #e3e3e3;border-radius:5px;background:#ffffff;color:#222222;box-shadow:none}\n.mine .location-message-card{--chat-fill:#ffffff;background:#ffffff;color:#222222}\n.location-info{order:-1;padding:12px 13px;gap:6px 10px}.location-name strong{font-size:13px;color:#222222}\n.location-name small{color:#999999}.location-distance{border:0;min-width:0;padding-left:0}.location-distance strong{font-size:10px;color:#888888}\n.location-map{height:112px;border-radius:0 0 5px 5px}\n.location-tiles img{filter:none}.location-pin{background:#e45e53;color:#ffffff}\n.location-detail{color:#888888;border-color:#eeeeee}.location-card-foot{color:#999999;border-color:#eeeeee;order:2}\n.music-chat-invite,.image-description-card{background:#ffffff;border-color:#e3e3e3;border-radius:5px;color:#333333}\n.chat-pat-card{background:transparent;color:#999999}\n\n.transfer-message-card::after,.mine .transfer-message-card::after,.location-message-card::after,.mine .location-message-card::after{content:none;display:none}\n.transfer-message-card{display:grid;grid-template-columns:42px minmax(0,1fr);grid-template-areas:\"icon amount\" \"icon note\" \"exchange exchange\" \"brand brand\";column-gap:10px;row-gap:0;padding:15px 13px 0;min-height:98px;background:#f79d36}\n.transfer-card-head{display:contents}.transfer-card-head>span:not(.transfer-symbol),.transfer-card-head>small,.transfer-parties{display:none}\n.transfer-symbol{grid-area:icon;align-self:center;width:36px;height:36px;border:1.5px solid #fff;border-radius:50%;margin-bottom:12px}.transfer-symbol svg{width:23px;height:23px}\n.transfer-amount{grid-area:amount;margin:0;padding:0 0 3px;border:0;display:block}.transfer-amount>span{display:none}.transfer-amount>strong{font-size:20px;font-weight:400;line-height:1.25}\n.transfer-note{grid-area:note;display:block;margin:0;padding:0 0 13px;background:transparent;color:#fff;border-radius:0}.transfer-note>small{display:none}.transfer-note>p{font-size:11px;line-height:1.5;color:#fff}\n.transfer-exchange{grid-area:exchange;margin:0 0 10px;font-size:9px}.transfer-note-translation{border-color:#ffffff44;color:#fff}\n.transfer-message-card::before{content:\"转账\";grid-area:brand;display:block;margin:0 -13px;padding:7px 12px;border-top:1px solid #eee;border-radius:0 0 5px 5px;background:#fff;color:#999;font-size:9px;line-height:1.4}\n.transfer-message-card .transfer-actions{grid-area:brand;z-index:1;display:flex;justify-content:flex-end;align-items:center;gap:12px;margin:0 -13px;padding:6px 12px;border-top:0;border-radius:0;background:transparent}.transfer-actions button{padding:0;font-size:10px;line-height:1.6}\n.transfer-message-card:not(:has(.transfer-actions)) .transfer-card-head>small{display:block;grid-area:brand;z-index:2;justify-self:end;align-self:center;margin:0;color:#999;font-size:9px;opacity:1}\n.voice-message-wrap{width:min(calc((var(--voice-width,176px) - 140px)*.65 + 70px),100%)}\n.voice-message-card{min-height:40px;padding:0 12px;gap:10px}.voice-wave,.voice-toggle-mark{display:none}.voice-duration{margin-left:auto;font-size:12px;color:inherit}\n.voice-mark{position:relative;width:18px;height:22px;background:radial-gradient(circle at 1px 50%,currentColor 0 1.6px,transparent 2px)}.voice-mark svg{display:none}\n.voice-mark::before,.voice-mark::after{content:\"\";position:absolute;left:0;top:50%;border-right:2px solid currentColor;border-radius:50%;transform:translateY(-50%)}.voice-mark::before{width:7px;height:10px}.voice-mark::after{width:12px;height:19px}\n.mine .voice-message-card{flex-direction:row-reverse}.mine .voice-mark{transform:rotate(180deg)}.mine .voice-duration{margin-left:0;margin-right:auto}\n\n\n.topbar{min-height:calc(var(--app-safe-top,0px) + 58px);padding-top:calc(var(--app-safe-top,0px) + 12px);padding-bottom:12px;gap:12px;align-items:center;border-bottom:1px solid #e9e9e9}\n.topbar #chatTitle{font-size:0;line-height:1.2;letter-spacing:0;min-width:0;flex:1;cursor:pointer}\n.topbar #chatTitle .chat-character-name{display:block;font:600 17px/1.4 -apple-system,BlinkMacSystemFont,sans-serif;letter-spacing:0;color:#161616;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;margin:0}\n.topbar .top-actions{display:flex;align-items:center;gap:14px}.topbar .avatar-stack{height:30px}.topbar .avatar-stack .avatar{width:27px;height:27px;font-size:12px;border:2px solid #fff}\n.topbar .settings-button{position:relative;width:30px;height:30px;color:#171717}.topbar .settings-button svg{opacity:0}.topbar .settings-button::before{content:\"•••\";position:absolute;inset:0;display:grid;place-items:center;font:600 15px -apple-system,BlinkMacSystemFont,sans-serif;letter-spacing:1px}\n.bottom{background:#fff;border-top:1px solid #ececec}.bottom .quick-features{background:transparent}.bottom .quick-item{color:#333}.bottom .quick-icon svg{background:#f1f1f1;color:#333}.bottom .quick-exit .quick-icon svg{background:#333;color:#fff}.composer{align-items:center;gap:8px;padding-top:4px}.composer .input-wrap{min-height:38px;height:38px;padding:7px 9px 7px 11px;border:1px solid #dedede;border-radius:5px;background:#fff;box-shadow:none}.composer textarea{font-size:14px;line-height:22px;color:#171717}.composer .emoji{width:25px;height:25px;color:#333}\n.composer .circle.small{width:36px;height:36px;border-radius:5px;box-shadow:none}.composer #inputFunctions{background:#f3f3f3;border:1px solid #dedede;color:#333}.composer #reply{background:#07b75b;border:1px solid #07b75b;color:#fff}.composer #reply svg{width:20px;height:20px}\n.dock-capsule{border:0;border-radius:0;box-shadow:none;background:#fff}.dock-tab{border-radius:5px;color:#777}.dock-tab.is-current{background:transparent;color:#07a653}.dock-add{background:#fff;border-color:#dedede;color:#555;border-radius:6px}\n\n"
