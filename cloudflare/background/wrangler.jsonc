{
  "$schema": "../../../node_modules/wrangler/config-schema.json",
  "name": "iris-background",
  "account_id": "55024ce493b1e2e46f4ca0978172aa5b",
  "main": "worker.mjs",
  "compatibility_date": "2026-10-18",
  "workers_dev": true,
  "routes": [{"pattern":"background-api.suri.us.ci","custom_domain":true}],
  "preview_urls": false,
  "vars": {
