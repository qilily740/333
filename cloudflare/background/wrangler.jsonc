    "MAX_GLOBAL_ATTEMPTS": "1000"
  },
  "durable_objects": {"bindings": [{"name":"BACKGROUND","class_name":"IrisBackground"}]},
  "migrations": [{"tag":"background-v1","new_sqlite_classes":["IrisBackground"]}]
